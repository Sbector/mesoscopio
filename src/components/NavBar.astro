---
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  backUrl?: string;
  backLabel?: string;
  showLangSelector?: boolean;
  currentLang?: "en" | "es";
}

const {
  backUrl,
  backLabel = "Back",
  showLangSelector = false,
  currentLang = "en",
} = Astro.props;
---

<nav class="w-full py-4 px-4 sm:px-6 lg:px-8 border-b border-earth-200 dark:border-earth-700 sticky top-0 bg-earth-50/95 dark:bg-earth-800/95 backdrop-blur-sm z-40">
  <div class="section-container flex items-center justify-between">
    <!-- Logo + Back Link -->
    <div class="flex items-center gap-4">
      <a href="/" class="text-xl font-bold text-earth-900 dark:text-earth-50 hover:text-clay-600 dark:hover:text-clay-400 transition-colors">
        Mesoscopio
      </a>

      {backUrl && (
        <>
          <span class="text-earth-300 dark:text-earth-600">|</span>
          <a
            href={backUrl}
            class="flex items-center gap-2 text-sm text-clay-500 hover:text-clay-600 dark:hover:text-clay-400 transition-colors"
          >
            <span>←</span>
            <span>{backLabel}</span>
          </a>
        </>
      )}
    </div>

    <!-- Right side: Language Selector + Theme Toggle -->
    <div class="flex items-center gap-4">
      {showLangSelector && (
        <LanguageSelector currentLang={currentLang} />
      )}

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        class="p-2 rounded-lg bg-earth-200 text-earth-900 hover:bg-earth-300 dark:bg-earth-700 dark:text-earth-100 dark:hover:bg-earth-600 transition-colors"
        aria-label="Toggle dark mode"
      >
        <svg
          id="theme-icon"
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <!-- Sun icon (shown in light mode) -->
          <g id="sun-icon" class="hidden">
            <circle cx="10" cy="10" r="4" />
            <circle cx="10" cy="2" r="1.5" />
            <circle cx="10" cy="18" r="1.5" />
            <circle cx="2" cy="10" r="1.5" />
            <circle cx="18" cy="10" r="1.5" />
            <circle cx="4" cy="4" r="1.5" />
            <circle cx="16" cy="16" r="1.5" />
            <circle cx="16" cy="4" r="1.5" />
            <circle cx="4" cy="16" r="1.5" />
          </g>

          <!-- Moon icon (shown in dark mode) -->
          <path
            id="moon-icon"
            d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
          />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Anti-FOUC: Set theme immediately when DOM loads
  const html = document.documentElement;
  const storedTheme = localStorage.getItem("theme");
  if (storedTheme === "dark" || (!storedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
    html.classList.add("dark");
  } else {
    html.classList.remove("dark");
  }

  // Theme toggle button handler
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("sun-icon")!;
  const moonIcon = document.getElementById("moon-icon")!;

  function updateThemeIcon() {
    if (html.classList.contains("dark")) {
      moonIcon.classList.remove("hidden");
      sunIcon.classList.add("hidden");
    } else {
      sunIcon.classList.remove("hidden");
      moonIcon.classList.add("hidden");
    }
  }

  // Initialize icon
  updateThemeIcon();

  themeToggle?.addEventListener("click", () => {
    const isDark = html.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateThemeIcon();
  });
</script>
