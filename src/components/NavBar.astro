---
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  backUrl?: string;
  backLabel?: string;
  showLangSelector?: boolean;
  currentLang?: "en" | "es";
}

const {
  backUrl,
  backLabel = "Back",
  showLangSelector = false,
  currentLang = "en",
} = Astro.props;
---

<nav class="w-full py-4 px-4 sm:px-6 lg:px-8 border-b border-earth-200 dark:border-earth-700 sticky top-0 bg-earth-50/95 dark:bg-earth-800/95 backdrop-blur-sm z-40">
  <div class="section-container flex items-center justify-between">
    <!-- Logo + Navigation -->
    <div class="flex items-center gap-6">
      <a href="/" class="text-xl font-bold text-earth-900 dark:text-earth-50 hover:text-clay-600 dark:hover:text-clay-400 transition-colors">
        Mesoscopio
      </a>

      {backUrl && (
        <>
          <span class="text-earth-300 dark:text-earth-600">|</span>
          <a
            href={backUrl}
            class="flex items-center gap-2 text-sm text-clay-500 hover:text-clay-600 dark:hover:text-clay-400 transition-colors"
          >
            <span>←</span>
            <span>{backLabel}</span>
          </a>
        </>
      )}

      {/* Main Navigation Links */}
      {!backUrl && (
        <>
          <span class="text-earth-300 dark:text-earth-600">|</span>
          <div class="flex items-center gap-4">
            <a href="/sandbox" class="text-sm font-medium text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400 transition-colors">
              Sandbox
            </a>
            <a href="/about" class="text-sm font-medium text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400 transition-colors">
              About
            </a>
          </div>
        </>
      )}
    </div>

    <!-- Right side: Language Selector -->
    <div class="flex items-center gap-4">
      {showLangSelector && (
        <LanguageSelector currentLang={currentLang} />
      )}
    </div>
  </div>
</nav>
