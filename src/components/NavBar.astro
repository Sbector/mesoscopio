---
import LanguageSelector from "./LanguageSelector.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<nav class="w-full py-4 px-4 sm:px-6 lg:px-8 border-b border-earth-200 dark:border-earth-700 sticky top-0 bg-earth-50/95 dark:bg-earth-800/95 backdrop-blur-sm z-40">
  <div class="section-container flex items-center justify-between">
    <!-- Logo + Navigation -->
    <div class="flex items-center gap-6">
      <a href="/" class="text-xl font-bold text-earth-900 dark:text-earth-50 hover:text-clay-600 dark:hover:text-clay-400 transition-colors">
        Mesoscopio
      </a>

      <span class="text-earth-300 dark:text-earth-600">|</span>

      <div class="flex items-center gap-4">
        <a
          href="/sandbox"
          aria-current={isActive("/sandbox") ? "page" : undefined}
          class:list={[
            "text-sm font-medium transition-colors",
            isActive("/sandbox")
              ? "text-clay-500 dark:text-clay-400"
              : "text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400",
          ]}
        >
          Sandbox
        </a>
        <a
          href="/modelos"
          aria-current={isActive("/modelos") ? "page" : undefined}
          class:list={[
            "text-sm font-medium transition-colors",
            isActive("/modelos")
              ? "text-clay-500 dark:text-clay-400"
              : "text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400",
          ]}
        >
          Models
        </a>
        <a
          href="/about"
          aria-current={isActive("/about") ? "page" : undefined}
          class:list={[
            "text-sm font-medium transition-colors",
            isActive("/about")
              ? "text-clay-500 dark:text-clay-400"
              : "text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400",
          ]}
        >
          About
        </a>
      </div>
    </div>

    <!-- Right side: Language Selector -->
    <div class="flex items-center gap-4">
      <LanguageSelector />
    </div>
  </div>
</nav>
