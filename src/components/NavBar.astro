---
import LanguageSelector from "./LanguageSelector.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const linkClass = (href: string) =>
  [
    "text-sm font-medium transition-colors",
    isActive(href)
      ? "text-clay-500 dark:text-clay-400"
      : "text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400",
  ];
---

<nav
  id="nav"
  class="w-full py-2.5 px-4 sm:px-6 lg:px-8 border-b border-earth-200 dark:border-earth-700 sticky top-0 bg-earth-50/95 dark:bg-earth-800/95 backdrop-blur-sm z-40"
>
  <div class="section-container flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="text-lg font-bold text-earth-900 dark:text-earth-50 hover:text-clay-600 dark:hover:text-clay-400 transition-colors"
    >
      Mesoscopio
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-6">
      <span class="text-earth-300 dark:text-earth-600">|</span>

      <div class="flex items-center gap-4">
        <a
          href="/sandbox"
          aria-current={isActive("/sandbox") ? "page" : undefined}
          class:list={["hidden sm:inline", linkClass("/sandbox")]}
        >
          Sandbox
        </a>
        <a
          href="/modelos"
          aria-current={isActive("/modelos") ? "page" : undefined}
          class:list={linkClass("/modelos")}
        >
          Models
        </a>
        <a
          href="/about"
          aria-current={isActive("/about") ? "page" : undefined}
          class:list={linkClass("/about")}
        >
          About
        </a>
      </div>

      <LanguageSelector />
    </div>

    <!-- Hamburger button (mobile) -->
    <button
      id="nav-toggle"
      type="button"
      aria-label="Menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="lg:hidden p-2 -mr-2 rounded-lg text-earth-700 dark:text-earth-300 hover:bg-earth-200 dark:hover:bg-earth-700 transition-colors"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path id="ham-top" d="M4 7h16" class="transition-transform duration-300 origin-center" />
        <path id="ham-mid" d="M4 12h16" class="transition-opacity duration-300" />
        <path id="ham-bot" d="M4 17h16" class="transition-transform duration-300 origin-center" />
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <div
    id="mobile-menu"
    class="mobile-menu lg:hidden overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out"
  >
    <div class="flex flex-col items-center gap-1 py-4">
      <a
        href="/modelos"
        aria-current={isActive("/modelos") ? "page" : undefined}
        class:list={[
          "w-full text-center py-3 px-6 text-base font-medium transition-colors",
          isActive("/modelos")
            ? "text-clay-500 dark:text-clay-400"
            : "text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400",
        ]}
      >
        Models
      </a>
      <a
        href="/about"
        aria-current={isActive("/about") ? "page" : undefined}
        class:list={[
          "w-full text-center py-3 px-6 text-base font-medium transition-colors",
          isActive("/about")
            ? "text-clay-500 dark:text-clay-400"
            : "text-earth-700 dark:text-earth-300 hover:text-clay-600 dark:hover:text-clay-400",
        ]}
      >
        About
      </a>

      <div class="w-3/4 h-px bg-earth-200 dark:bg-earth-700 my-2"></div>

      <div class="py-2">
        <LanguageSelector />
      </div>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const nav = document.getElementById("nav");
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!nav || !toggle || !menu) return;

    const top = document.getElementById("ham-top");
    const mid = document.getElementById("ham-mid");
    const bot = document.getElementById("ham-bot");

    const close = () => {
      nav.removeAttribute("data-menu-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    const toggleMenu = () => {
      const open = nav.hasAttribute("data-menu-open");
      if (open) close();
      else {
        nav.setAttribute("data-menu-open", "");
        toggle.setAttribute("aria-expanded", "true");
      }
    };

    toggle.addEventListener("click", toggleMenu);

    // Close on link click
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", close)
    );

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    // Close on outside click
    document.addEventListener("click", (e) => {
      if (!nav.contains(e.target as Node)) close();
    });

    // Auto-close on orientation change (landscape on phones)
    window.addEventListener("orientationchange", () => {
      // Wait for the new layout to settle
      window.setTimeout(close, 100);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNav);
  } else {
    initNav();
  }

  document.addEventListener("astro:before-preparation", initNav);
</script>

<style>
  /* Hamburger → ✕ animation */
  #nav[data-menu-open] #ham-top {
    transform: translateY(5px) rotate(45deg);
  }
  #nav[data-menu-open] #ham-mid {
    opacity: 0;
  }
  #nav[data-menu-open] #ham-bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* Dropdown open state */
  #nav[data-menu-open] #mobile-menu {
    max-height: 24rem;
    opacity: 1;
  }
</style>
