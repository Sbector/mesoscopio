---
interface Props {
  title: string
  description?: string
  preview?: string
  video?: string
  href: string
}

const { title, description, preview, video, href } = Astro.props
---

<a href={href} class="group block h-full">
  <figure class="scrub-card relative w-full aspect-square overflow-hidden rounded-lg border border-earth-200 dark:border-earth-700 bg-earth-100 dark:bg-earth-700 hover:border-clay-400 dark:hover:border-clay-400 transition-all duration-300" data-scrub-card>
    <!-- Video: always visible if available, with scrub interaction -->
    {video ? (
      <video
        class="scrub-video w-full h-full object-cover"
        src={video}
        muted
        playsinline
        preload="auto"
      />
    ) : (
      // Fallback: static preview image or placeholder
      preview ? (
        <img
          src={preview}
          alt={title}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-earth-200 to-earth-300 dark:from-earth-700 dark:to-earth-800">
          <div class="text-center">
            <div class="text-earth-600 dark:text-earth-400 text-sm">No preview</div>
          </div>
        </div>
      )
    )}

    <!-- Overlay: text info and scrub hint -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
      <div class="w-full">
        <h3 class="text-white font-semibold text-sm sm:text-base truncate">
          {title}
        </h3>
        {description && (
          <p class="text-white/80 text-xs sm:text-sm line-clamp-2 mt-1">
            {description}
          </p>
        )}
        {video && (
          <p class="text-white/60 text-xs mt-2">Drag to rotate →</p>
        )}
      </div>
    </div>
  </figure>
</a>

{video && (
  <script>
    // Scrub 3D interaction: fixed frame 0 by default, scrub only on hover
    function initScrubCards() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cards = document.querySelectorAll('[data-scrub-card]');
      
      cards.forEach((card) => {
        const videoEl = card.querySelector('.scrub-video');
        if (!videoEl) return;

        let isScrubbing = false;

        // Initialize video: always paused at frame 0
        videoEl.pause();
        videoEl.currentTime = 0;

        // Hover: enable scrub mode
        card.addEventListener('pointerenter', () => {
          if (!prefersReduced) {
            isScrubbing = true;
          }
        });

        // Move: scrub to frame based on cursor position
        card.addEventListener('pointermove', (e) => {
          if (!isScrubbing || !videoEl) return;

          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const ratio = Math.max(0, Math.min(1, x / rect.width));
          
          if (videoEl.duration) {
            const targetTime = ratio * videoEl.duration;
            // Use fastSeek if available (Firefox), else currentTime
            if (videoEl.fastSeek) {
              videoEl.fastSeek(targetTime);
            } else {
              videoEl.currentTime = targetTime;
            }
          }
        });

        // Leave: return to frame 0
        card.addEventListener('pointerleave', () => {
          isScrubbing = false;
          videoEl.pause();
          videoEl.currentTime = 0;
        });
      });
    }

    // Initialize on page load and when islands mount
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrubCards);
    } else {
      initScrubCards();
    }

    // Re-init on Astro page navigation (view transitions)
    document.addEventListener('astro:before-preparation', initScrubCards);
  </script>
)}
