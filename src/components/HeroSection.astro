---
interface Props {
  title_en: string
  title_es: string
  description_en: string
  description_es: string
  cta_text_en: string
  cta_text_es: string
  ctaUrl?: string
}

const { title_en, title_es, description_en, description_es, cta_text_en, cta_text_es, ctaUrl = '#modelos' } = Astro.props
---

<section class="relative w-full py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-earth-50 to-earth-100 dark:from-earth-800 dark:to-earth-900">
  <div class="max-w-4xl mx-auto text-center space-y-8">
    <div class="space-y-4">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight text-earth-900 dark:text-earth-50">
        <span data-i18n="en">{title_en}</span>
        <span data-i18n="es">{title_es}</span>
      </h1>
      <p class="text-lg sm:text-xl text-earth-600 dark:text-earth-300 leading-relaxed max-w-2xl mx-auto">
        <span data-i18n="en">{description_en}</span>
        <span data-i18n="es">{description_es}</span>
      </p>
    </div>

    <div class="flex gap-4 justify-center">
      <a
        href={ctaUrl}
        class="inline-flex px-8 py-3 bg-clay-500 hover:bg-clay-600 text-earth-50 font-semibold rounded-lg transition-colors duration-200"
      >
        <span data-i18n="en">{cta_text_en}</span>
        <span data-i18n="es">{cta_text_es}</span>
      </a>
    </div>
  </div>
</section>
