---
import ModelViewer from "./ModelViewer.jsx";

interface Props {
  title_en: string
  title_es: string
  description_en: string
  description_es: string
  cta_text_en: string
  cta_text_es: string
  ctaUrl?: string
  modelUrl?: string
}

const { title_en, title_es, description_en, description_es, cta_text_en, cta_text_es, ctaUrl = '#', modelUrl } = Astro.props
---

<section class="relative w-full py-20 px-4 sm:px-6 lg:px-8 bg-linear-to-br from-earth-50 to-earth-100 dark:from-earth-800 dark:to-earth-900">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="space-y-6">
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight tracking-tight">
          <span data-i18n="en">{title_en}</span>
          <span data-i18n="es">{title_es}</span>
        </h1>
        <p class="text-lg sm:text-xl text-earth-600 dark:text-earth-300 leading-relaxed">
          <span data-i18n="en">{description_en}</span>
          <span data-i18n="es">{description_es}</span>
        </p>
        <a
          href={ctaUrl}
          class="inline-block px-8 py-3 bg-clay-500 hover:bg-clay-600 text-earth-50 font-semibold rounded-lg transition-colors duration-200"
        >
          <span data-i18n="en">{cta_text_en}</span>
          <span data-i18n="es">{cta_text_es}</span>
        </a>
      </div>
      
      <!-- 3D Model Viewer -->
      {modelUrl && (
        <div class="relative">
          <ModelViewer client:visible model={modelUrl} />
          
          <!-- Overlay button -->
          <a
            href="/modelos"
            class="absolute bottom-4 right-4 px-4 py-2 bg-earth-900/80 dark:bg-earth-950/90 backdrop-blur text-earth-50 text-sm font-medium rounded-lg hover:bg-earth-800/90 transition-colors"
          >
            <span data-i18n="en">View all models →</span>
            <span data-i18n="es">Ver todos los modelos →</span>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
