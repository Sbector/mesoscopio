---
import type { CollectionEntry } from 'astro:content';

interface Props {
  models: CollectionEntry<'modelos'>[]
  descEn: string
  descEs: string
}

const { models, descEn, descEs } = Astro.props;

// Only models with video preview
const heroModels = models.filter((m) => m.data.video);
---

<!-- ============================================================
     MOBILE (< lg): fullscreen video bg + floating text card
     DESKTOP (lg+):  original flex-row layout
     ============================================================ -->
<section class="h-full lg:h-auto lg:min-h-full lg:py-6 px-0 lg:px-4 sm:px-6 lg:px-8 bg-earth-50 dark:bg-earth-900 flex items-center relative overflow-hidden">

  <!-- ── MOBILE: video fullscreen background ── -->
  <div class="hero-stage hero-stage-lg lg:hidden absolute inset-0 w-full h-full bg-earth-900 cursor-pointer select-none" role="button" tabindex="0" aria-label="Play or pause hero video">
    {heroModels.map((model, i) => (
      <video
        class:list={[
          "hero-video absolute inset-0 w-full h-full object-cover",
          i === 0 ? "is-active" : "",
        ]}
        data-hero-video={i}
        src={model.data.video}
        muted
        playsinline
        loop
        preload="auto"
      />
    ))}

    <!-- Dots indicator (mobile) -->
    <div class="absolute bottom-28 left-0 right-0 flex items-center justify-center gap-2 z-10">
      {heroModels.map((_, i) => (
        <span
          class:list={[
            "hero-dot w-2.5 h-2.5 rounded-full border border-white/60 transition-colors duration-300",
            i === 0
              ? "bg-white border-white"
              : "bg-transparent",
          ]}
          data-hero-dot={i}
        />
      ))}
    </div>
  </div>

  <!-- ── MOBILE: floating text card ── -->
  <div class="hero-card-lg lg:hidden absolute bottom-4 left-4 right-4 z-10 bg-white/80 backdrop-blur-sm rounded-xl shadow-lg p-6">
    <h1 class="text-2xl font-bold text-earth-900 mb-2">
      Mesoscopio
    </h1>
    <p class="text-earth-700 text-sm leading-relaxed mb-4">
      <span data-i18n="en">{descEn}</span>
      <span data-i18n="es">{descEs}</span>
    </p>
    <a href="/modelos" class="btn-primary inline-block py-3 px-6 text-sm w-full text-center">
      <span data-i18n="en">Explore collection</span>
      <span data-i18n="es">Explorar colección</span>
    </a>
  </div>

  <!-- ── DESKTOP: original layout (lg+) ── -->
  <div class="hidden lg:flex max-w-6xl mx-auto flex-row items-center gap-12">

    <!-- Left: square video stage -->
    <div class="hero-stage relative w-full max-w-md aspect-square bg-earth-100 dark:bg-earth-700 rounded-lg overflow-hidden border border-earth-200 dark:border-earth-700 mx-auto sm:mx-0 cursor-pointer select-none" role="button" tabindex="0" aria-label="Play or pause hero video">
      {heroModels.map((model, i) => (
        <video
          class:list={[
            "hero-video absolute inset-0 w-full h-full object-contain",
            i === 0 ? "is-active" : "",
          ]}
          data-hero-video-desktop={i}
          src={model.data.video}
          muted
          playsinline
          loop
          preload="auto"
        />
      ))}

      <!-- Dots indicator -->
      <div class="absolute bottom-3 left-0 right-0 flex items-center justify-center gap-2">
        {heroModels.map((_, i) => (
          <span
            class:list={[
              "hero-dot w-2.5 h-2.5 rounded-full border border-earth-400 transition-colors duration-300",
              i === 0
                ? "bg-clay-500 border-clay-500"
                : "bg-transparent",
            ]}
            data-hero-dot-desktop={i}
          />
        ))}
      </div>
    </div>

    <!-- Right: text + CTA -->
    <div class="flex-1 text-left">
      <h1 class="text-5xl font-bold text-earth-900 dark:text-earth-50 mb-4">
        Mesoscopio
      </h1>
      <p class="text-earth-700 dark:text-earth-300 text-lg leading-relaxed mb-8">
        <span data-i18n="en">{descEn}</span>
        <span data-i18n="es">{descEs}</span>
      </p>
      <a href="/modelos" class="btn-primary inline-block py-3 px-6 text-sm">
        <span data-i18n="en">Explore collection</span>
        <span data-i18n="es">Explorar colección</span>
      </a>
    </div>

  </div>
</section>

<style>
  .hero-video {
    opacity: 0;
    transition: opacity 0.6s ease-in;
    pointer-events: none;
  }
  .hero-video.is-active {
    opacity: 1;
    transition: opacity 0.6s ease-out;
  }
  .hero-stage:fullscreen .hero-video {
    object-fit: contain;
  }

  /* ── Landscape layout (mobile only, < lg) ── */
  @media (max-width: 1023px) and (orientation: landscape) {
    section {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 1.5rem !important;
      padding: 0 1rem !important;
    }

    .hero-stage-lg {
      position: relative !important;
      width: 55% !important;
      height: 80dvh !important;
      max-height: 400px !important;
      flex-shrink: 0 !important;
      border-radius: 0.75rem !important;
      border: 1px solid rgb(229 231 235) !important;
    }

    .hero-card-lg {
      position: relative !important;
      width: 45% !important;
      max-width: none !important;
      bottom: auto !important;
      left: auto !important;
      right: auto !important;
    }
  }
</style>

<script>
  function initHeroCarousel() {
    // Mobile videos
    const mobileVideos = Array.from(
      document.querySelectorAll<HTMLVideoElement>('[data-hero-video]')
    );
    const mobileDots = Array.from(
      document.querySelectorAll<HTMLElement>('[data-hero-dot]')
    );

    // Desktop videos
    const desktopVideos = Array.from(
      document.querySelectorAll<HTMLVideoElement>('[data-hero-video-desktop]')
    );
    const desktopDots = Array.from(
      document.querySelectorAll<HTMLElement>('[data-hero-dot-desktop]')
    );

    // Use mobile or desktop based on screen
    const isMobile = window.innerWidth < 1024;
    const videos = isMobile ? mobileVideos : desktopVideos;
    const dots = isMobile ? mobileDots : desktopDots;

    if (videos.length === 0) return;

    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const stages = document.querySelectorAll<HTMLElement>('.hero-stage');
    const stage = isMobile ? stages[0] : stages[1] || stages[0];

    let current = 0;
    const INTERVAL = 6000;
    let timer: number | null = null;
    let isHovering = false;

    const TRANSITION = 450;
    let switching = false;

    const resetVideo = (video: HTMLVideoElement | undefined) => {
      if (!video) return;
      video.pause();
      video.currentTime = 0;
    };

    const show = (index: number) => {
      if (switching || index === current) return;
      switching = true;

      const outgoing = videos[current];
      outgoing?.classList.remove('is-active');
      resetVideo(outgoing);
      dots[current]?.classList.remove(isMobile ? 'bg-white' : 'bg-clay-500', isMobile ? 'border-white' : 'border-clay-500');
      dots[current]?.classList.add('bg-transparent', isMobile ? 'border-white/60' : 'border-earth-400');

      window.setTimeout(() => {
        outgoing?.classList.remove('is-active');
        current = index;
        videos[current]?.classList.add('is-active');
        dots[current]?.classList.add(isMobile ? 'bg-white' : 'bg-clay-500', isMobile ? 'border-white' : 'border-clay-500');
        dots[current]?.classList.remove('bg-transparent', isMobile ? 'border-white/60' : 'border-earth-400');
        switching = false;
      }, TRANSITION);
    };

    const next = () => show((current + 1) % videos.length);

    const start = () => {
      if (prefersReduced || isHovering) return;
      if (timer === null) {
        timer = window.setInterval(next, INTERVAL);
      }
    };

    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };

    // Scrub interaction (desktop hover)
    let isScrubbing = false;

    const startScrub = () => {
      if (prefersReduced) return;
      isHovering = true;
      isScrubbing = true;
      stop();
    };

    const moveScrub = (clientX: number) => {
      if (!isScrubbing) return;
      const video = videos[current];
      if (!video || !video.duration) return;
      const rect = stage?.getBoundingClientRect();
      if (!rect) return;
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      video.currentTime = ratio * video.duration;
    };

    const endScrub = () => {
      isHovering = false;
      isScrubbing = false;
      resetVideo(videos[current]);
      start();
    };

    if (stage) {
      stage.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') startScrub();
      });
      stage.addEventListener('pointermove', (e) => {
        const evt = e as PointerEvent;
        if (evt.pointerType === 'mouse') moveScrub(evt.clientX);
      });
      stage.addEventListener('pointerleave', (e) => {
        const evt = e as PointerEvent;
        if (evt.pointerType === 'mouse') endScrub();
      });

      // Tap to play/pause (touch + keyboard)
      const togglePlay = () => {
        if (prefersReduced) return;
        const video = videos[current];
        if (!video) return;
        if (video.paused) {
          stop();
          video.play().catch(() => {});
          stage?.classList.add('is-playing');
        } else {
          video.pause();
          stage?.classList.remove('is-playing');
          start();
        }
      };

      stage.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') togglePlay();
      });
      stage.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          togglePlay();
        }
      });
    }

    // Pause cycling when hero is off-screen
    if (stage && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) start();
            else stop();
          });
        },
        { threshold: 0.25 }
      );
      observer.observe(stage);
    } else {
      start();
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        show(i);
        stop();
        start();
      });
      dot.classList.add('cursor-pointer');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousel);
  } else {
    initHeroCarousel();
  }

  document.addEventListener('astro:before-preparation', initHeroCarousel);
</script>
