---
import '@/styles/global.css'
import NavBar from '@/components/NavBar.astro'

interface Props {
  title?: string
  description?: string
  lang?: 'en' | 'es'
  backUrl?: string
  backLabel?: string
  showLangSelector?: boolean
  currentLang?: 'en' | 'es'
  fullscreen?: boolean
}

const {
  title = 'Mesoscopio',
  description = 'Mesoscopio - Advanced 3D Capture',
  lang = 'en',
  backUrl,
  backLabel,
  showLangSelector = false,
  currentLang = 'en',
  fullscreen = false,
} = Astro.props
---

<!doctype html>
<html lang={lang} data-lang="es" class:list={[fullscreen && 'h-dvh overflow-hidden']}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Anti-FOUC: Apply light theme always -->
		<script is:inline>
			document.documentElement.classList.remove('dark')
			document.documentElement.dataset.lang = new URLSearchParams(location.search).get('lang') || 'es'
		</script>
	</head>
	<body class:list={['antialiased', fullscreen && 'h-dvh overflow-hidden']}>
		<NavBar
			backUrl={backUrl}
			backLabel={backLabel}
			showLangSelector={showLangSelector}
			currentLang={currentLang}
		/>
		<div class:list={['flex flex-col', fullscreen ? 'h-full overflow-hidden' : 'min-h-screen']}>
			<slot />
		</div>
	</body>
</html>
