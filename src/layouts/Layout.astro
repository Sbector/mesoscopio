---
import '@/styles/global.css'
import NavBar from '@/components/NavBar.astro'

interface Props {
  title?: string
  description?: string
  lang?: 'en' | 'es'
  fullscreen?: boolean
}

const {
  title = 'Mesoscopio',
  description = 'Mesoscopio - Advanced 3D Capture',
  lang = 'en',
  fullscreen = false,
} = Astro.props
---

<!doctype html>
<html lang={lang} data-lang="es" class:list={[fullscreen && 'h-dvh overflow-hidden']}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Anti-FOUC: Apply light theme always -->
		<script is:inline>
			document.documentElement.classList.remove('dark')
			document.documentElement.dataset.lang = new URLSearchParams(location.search).get('lang') || 'es'
		</script>
	</head>
	<body class:list={['antialiased flex flex-col h-dvh', fullscreen && 'overflow-hidden']}>
		<NavBar />
		<div class:list={['flex-1 overflow-y-auto', fullscreen && 'flex flex-col overflow-hidden']}>
			<slot />
		</div>
	</body>
</html>
