---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import ModelViewer from "@/components/ModelViewer.jsx";

export async function getStaticPaths() {
    const modelos = await getCollection("modelos");

    return modelos.map((item) => ({
        params: { slug: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { title, description, model } = item.data;
---

<Layout title={`${title} | Mesoscopio`}>
    <main class="grow p-6 sm:p-10">
        <div class="max-w-4xl mx-auto space-y-6">
            <div>
                <h1 class="text-4xl font-bold text-earth-900 dark:text-earth-50 mb-2">{title}</h1>
                {description && (
                    <p class="text-lg text-earth-600 dark:text-earth-300">
                        {description}
                    </p>
                )}
            </div>

            {/* 3D Model Viewer */}
            {model && (
                <div class="bg-earth-100 dark:bg-earth-800 rounded-lg overflow-hidden">
                    <ModelViewer client:visible model={model} />
                </div>
            )}
        </div>
    </main>
</Layout>
