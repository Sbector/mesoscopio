---
import Layout from "@/layouts/Layout.astro";
import ModelsGrid from "@/components/ModelsGrid.astro";
import { getCollection } from "astro:content";

const modelos = await getCollection("modelos");
---

<Layout backUrl="/" backLabel="Home">
	<main class="grow">
		<ModelsGrid models={modelos} />
	</main>
</Layout>