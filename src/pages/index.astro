---
import Layout from "@/layouts/Layout.astro";
import ModelsGrid from "@/components/ModelsGrid.astro";
import { getCollection } from "astro:content";

// Get models
const modelos = await getCollection("modelos");
---

<Layout
  title="Mesoscopio | 3D Models"
  description="Explore our collection of high-fidelity 3D scans"
  lang="es"
>
  <main class="grow">
    <ModelsGrid models={modelos} />
  </main>
</Layout>
